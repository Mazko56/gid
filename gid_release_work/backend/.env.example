NODE_ENV=production
PORT=3001
ALLOWED_ORIGINS=https://your-frontend-domain.up.railway.app
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=10
DB_AUTO_MIGRATE=true
DB_AUTO_SEED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE=86400
SESSION_DAYS=30
ADMIN_API_KEY=
DEV_AUTH_BYPASS=false

# Server-only Google Places API (New) key.
# Enable Places API (New) in the same Google Cloud project and restrict this key to that API.
GOOGLE_MAPS_SERVER_API_KEY=

# Primary tourist places/routing provider (server-side).
GEOAPIFY_API_KEY=
