# Public URL of the Stage 2 API. In Railway use the backend service HTTPS domain.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Server-side backend origin used by the Next.js Stage 2 proxies.
# Root domain or URL ending in /api/v1 are both accepted. This is NOT exposed to the browser.
BACKEND_API_URL=http://localhost:3001

# Server-side admin key for /admin/admin-stage2. Keep it identical to backend ADMIN_API_KEY.
# This lets the admin screen work without exposing the secret in browser storage.
STAGE2_ADMIN_API_KEY=

# Google Maps JavaScript API key for rendering real Google maps in the Mini App.
# Restrict this key by HTTP referrer to the production frontend domain.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=

# Used only when the app is opened without a Telegram start parameter (local/staging test).
NEXT_PUBLIC_DEFAULT_QR_START_PARAM=guide-tatariv

# Regional community fallback if the current Region record has no community_url.
NEXT_PUBLIC_TELEGRAM_COMMUNITY_URL=

# Used by the admin QR screen to build native Telegram startapp links.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_APP_SHORT_NAME=
